{
  "name": "replicated",
  "displayName": "Replicated",
  "description": "Get your first working release on Replicated and test in customer-representative environments.",
  "version": "0.0.2",
  "publisher": "replicated",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "img/replicated_logomark.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:replicated.lint.enable",
    "onView:replicatedManifests",
    "onView:replicatedActions"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "replicated",
          "title": "Replicated",
          "icon": "img/replicated-sidebar.svg"
        }
      ]
    },
    "views": {
      "replicated": [
        {
          "id": "replicatedManifests",
          "name": "Manifests"
        },
        {
          "id": "replicatedActions",
          "name": "Replicated Dev"
        }
      ]
    },
    "commands": [
      {
        "command": "replicated.lint.enable",
        "title": "Replicated: Enable Lint"
      },
      {
        "command": "replicated.lint.disable",
        "title": "Replicated: Disable Lint"
      },
      {
        "command": "replicated.toggleAutoLint",
        "title": "Replicated: Toggle Auto-lint on Save"
      },
      {
        "command": "replicated.lintAll",
        "title": "Replicated: Lint All Manifests",
        "icon": "$(play)"
      },
      {
        "command": "replicated.lintFile",
        "title": "Lint File",
        "icon": "$(check)"
      },
      {
        "command": "replicated.refreshManifests",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "replicated.openManifest",
        "title": "Open Manifest"
      },
      {
        "command": "replicated.testInEnvironment",
        "title": "Replicated: Test in Environment",
        "icon": "$(rocket)"
      },
      {
        "command": "replicated.installCLI",
        "title": "Replicated: Install CLI",
        "icon": "$(cloud-download)"
      },
      {
        "command": "replicated.checkCLI",
        "title": "Replicated: Check CLI Status",
        "icon": "$(refresh)"
      },
      {
        "command": "replicated.testInEnvironmentDirect",
        "title": "Test in Environment (Direct)",
        "icon": "$(rocket)"
      },
      {
        "command": "replicated.showClusterResources",
        "title": "Replicated: Show Cluster Resources",
        "icon": "$(server)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "replicated.lintAll",
          "when": "view == replicatedManifests",
          "group": "navigation@1",
          "icon": "$(play)"
        },
        {
          "command": "replicated.refreshManifests",
          "when": "view == replicatedManifests",
          "group": "navigation@2",
          "icon": "$(refresh)"
        }
      ],
      "view/item/context": [
        {
          "command": "replicated.lintFile",
          "when": "view == replicatedManifests && viewItem == manifestFile",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Replicated",
      "properties": {
        "replicated.manifestsFolder": {
          "type": "string",
          "scope": "resource",
          "default": "manifests",
          "description": "%config.manifestsFolder%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "got": "11.8.3",
    "tar": "^6.1.13",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.18.126",
    "@types/tar": "^6.1.3",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdewinne/vscode-replicated"
  }
}
